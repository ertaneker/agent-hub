# ~/.agent-hub/telegram.env  (izinleri: chmod 600)
# 1) Telegram'da @BotFather'a /newbot yaz, verdiği token'ı aşağıya koy.
# 2) Kendi botuna herhangi bir mesaj gönder.
# 3) python3 ~/.agent-hub/bin/tg_bridge.py --chat-id  çıktısındaki sayıyı aşağıya koy.
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
